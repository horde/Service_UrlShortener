{
    "name": "horde/service_urlshortener",
    "description": "URL shortening library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Service_UrlShortener",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Michael J Rubinsky",
            "email": "mrubinsk@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-03-07",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/url": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {},
    "suggest": {
        "horde/http": "^3 || dev-FRAMEWORK_6_0",
        "phpunit/phpunit": "^11 || ^12"
    },
    "autoload": {
        "psr-0": {
            "Horde_Service_UrlShortener": "lib/"
        },
        "psr-4": {
            "Horde\\Service\\UrlShortener\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Service\\UrlShortener\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}